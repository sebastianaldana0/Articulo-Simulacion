\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Variación anual del encasetamiento y de la producción de huevo, 2019--2026 (suma de 12 meses frente a los 12 anteriores). Las flechas unen cada pico o valle del encasetamiento (extremo en una ventana de $\pm $12 meses) con el de la producción entre 6 y 18 meses después. Línea discontinua: producción estimada. Fuente: elaboración propia con base en \citet  {Fenavi2026Estadisticas}.}}{21}{figure.3}\protected@file@percent }
\newlabel{fig:rezago}{{3}{21}{Variación anual del encasetamiento y de la producción de huevo, 2019--2026 (suma de 12 meses frente a los 12 anteriores). Las flechas unen cada pico o valle del encasetamiento (extremo en una ventana de $\pm $12 meses) con el de la producción entre 6 y 18 meses después. Línea discontinua: producción estimada. Fuente: elaboración propia con base en \citet {Fenavi2026Estadisticas}}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Sobreoferta de huevo y precio real, 2019--2026. (a) Producción por habitante frente a su tendencia; (b) precio real del huevo frente a su tendencia. Tendencias log-lineales estimadas con datos de julio de 2018 a diciembre de 2025; la de la producción por habitante, de 2,7~\% al año, se toma como el consumo que el mercado absorbe sin cambiar el precio. Barras claras: producción de 2026 estimada. Fuente: elaboración propia con base en \citet  {Fenavi2026Estadisticas}, \citet  {DANE2026SIPSA} y \citet  {DANE2025Poblacion}.}}{22}{figure.4}\protected@file@percent }
\newlabel{fig:sobreoferta}{{4}{22}{Sobreoferta de huevo y precio real, 2019--2026. (a) Producción por habitante frente a su tendencia; (b) precio real del huevo frente a su tendencia. Tendencias log-lineales estimadas con datos de julio de 2018 a diciembre de 2025; la de la producción por habitante, de 2,7~\% al año, se toma como el consumo que el mercado absorbe sin cambiar el precio. Barras claras: producción de 2026 estimada. Fuente: elaboración propia con base en \citet {Fenavi2026Estadisticas}, \citet {DANE2026SIPSA} y \citet {DANE2025Poblacion}}{figure.4}{}}
