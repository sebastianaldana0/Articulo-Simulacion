		,(589,2.1074e+06),(590,2.1074e+06),(591,2.1074e+06),(592,2.1074e+06),(593,2.1074e+06)\
		,(594,2.1074e+06),(595,2.1074e+06),(596,2.1074e+06),(597,2.1074e+06),(598,2.1074e+06)\
