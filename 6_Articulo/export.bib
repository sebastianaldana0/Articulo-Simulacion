@article{Harlow1960,
   abstract = {<p>A surprisingly regular four year cycle in hogs has become apparent in the past ten years. This regularity presents an unusual opportunity to study the mechanism of the cycle because it suggests the cycle may be inherent within the industry rather than the result of lagged responses to outside influences. The cobweb theorem is often mentioned as a theoretical tool for explaining the hog cycle, although a two year cycle is usually predicted. When the nature of the hog industry is examined, certain factors become apparent which enable the cobweb theorem to serve as a theoretical basis for the present four year cycle.</p>},
   author = {Arthur A. Harlow},
   doi = {10.2307/1235116},
   issn = {0002-9092},
   issue = {4},
   journal = {American Journal of Agricultural Economics},
   month = {11},
   pages = {842-853},
   title = {The Hog Cycle and the Cobweb Theorem},
   volume = {42},
   year = {1960}
}
